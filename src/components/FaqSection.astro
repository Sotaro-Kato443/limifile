---
import type { FaqItem } from "../i18n/page-content-types";

interface Props {
  heading: string;
  items: FaqItem[];
}

const { heading, items } = Astro.props;
---

<section class="tool-page-faq">
  <h2>{heading}</h2>
  <div class="faq-list">
    {
      items.map((item) => (
        <details class="faq-item">
          <summary class="faq-item__summary">
            <h3>{item.question}</h3>
          </summary>
          <div class="faq-item__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>
