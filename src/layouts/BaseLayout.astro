---
import "../styles/global.css";
import { getLocaleDefinition, type LocaleKey } from "../i18n/locales";
import { buildPublicAbsoluteUrl } from "../i18n/urls";

export interface AlternateUrl {
  hreflang: string;
  href: string;
}

interface Props {
  /** このページのロケール(<html lang>・og:localeの決定に使う) */
  locale: LocaleKey;
  title: string;
  description: string;
  /**
   * このページの正規パス(locale prefix・末尾スラッシュを含む、公開URL形式の最終的なpathname、
   * 例: "/heic-to-jpg/"・"/ja/heic-to-jpg/"・"/")。省略した場合、canonical・og:urlは出力しない
   * (例: 404ページ)。
   */
  canonicalPath?: string;
  /** 最終的なindex許可可否(サイト全体ゲート・ページ個別設定を合成済みの値) */
  indexable: boolean;
  /** 実在する翻訳ページのみを対象にしたhreflang alternate一覧。省略時は出力しない */
  alternateUrls?: AlternateUrl[];
  /** x-defaultとして示すURL。適切な既定言語ページが実在する場合のみ渡す */
  xDefaultUrl?: string;
  ogType?: string;
  structuredData?: Record<string, unknown>;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  indexable,
  alternateUrls = [],
  xDefaultUrl,
  ogType = "website",
  structuredData,
} = Astro.props;

const localeDefinition = getLocaleDefinition(locale);
const origin = Astro.site ? Astro.site.toString().replace(/\/+$/, "") : "";
const canonicalUrl =
  canonicalPath && origin ? buildPublicAbsoluteUrl(origin, canonicalPath) : undefined;
const ogImageUrl = origin ? `${origin}/brand/limifile-og.png` : undefined;
const ogImageAlt =
  locale === "ja"
    ? "LimiFile — 画像の変換・圧縮を、もっと手軽に。ファイルをサーバーへ送らず、端末内で処理"
    : "LimiFile — Convert and compress images more easily. Files are processed on your device without being sent to a server.";
---

<!doctype html>
<html lang={localeDefinition.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/limifile-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="LimiFile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content={localeDefinition.ogLocale} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:secure_url" content={ogImageUrl} />}
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {
      alternateUrls.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }
    {xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
    {
      structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
