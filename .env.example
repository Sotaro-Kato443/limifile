# このファイルは変数名と説明のみを記載します。実際の値は.env(gitignore対象)や
# Cloudflare Pagesのビルド時環境変数として設定してください。値をコミットしないでください。

# サイト全体の検索エンジンインデックス許可を制御します(ビルド時にのみ評価される静的な値)。
# 厳密に文字列"true"の場合のみページ個別のindexable設定を参照します。
# 未設定・"false"・その他の値は安全側として全ページnoindexになります。
# 正式公開時は、各ページのindexable設定・本文・FAQ・法務確認が完了してから"true"に変更してください。
PUBLIC_ALLOW_INDEXING=false

# Umami Cloudで作成したLimiFile siteの公開website UUIDです。
# 未設定・空文字の場合、Umami tracker scriptとツールイベント送信は完全に無効になります。
# 実値はCloudflare PagesのProduction環境変数へ設定し、このファイルには記載しません。
PUBLIC_UMAMI_WEBSITE_ID=

# 通常は未設定のままにし、https://cloud.umami.is/script.jsを使用します。
# 将来Umamiをセルフホストする場合のみ、そのHTTPS tracker URLへ変更します。
PUBLIC_UMAMI_SCRIPT_URL=
