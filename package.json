    "verify:trust-pages": "node scripts/verify-trust-pages.mjs",
    "verify:tool-seo-content": "node scripts/verify-tool-seo-content.mjs",
    "verify:search-publication": "node scripts/verify-search-publication.mjs",
    "verify:lgpl-heic-source-package": "node scripts/verify-lgpl-heic-source-package.mjs",
    "build:lgpl-heic-source-package": "node scripts/build-lgpl-heic-source-package.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.1",
    "@discourse/heic": "1.0.0",
